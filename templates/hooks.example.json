{
  "_comment": "Reference shape only. Installer uses POSIX shell quoting and an encoded PowerShell command on Windows; install creates project-local hooks only with explicit --hooks opt-in.",
  "description": "Project state injection and one-shot freshness check for the native Codex orchestrator workflow.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/absolute/path/to/repo/.codex/hooks/inject_project_state.py'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand JgAgACcAQwA6AFwAUABhAHQAaABcAHQAbwBcAHAAeQB0AGgAbwBuAC4AZQB4AGUAJwAgACcAQwA6AFwAcgBlAHAAbwBcAC4AYwBvAGQAZQB4AFwAaABvAG8AawBzAFwAaQBuAGoAZQBjAHQAXwBwAHIAbwBqAGUAYwB0AF8AcwB0AGEAdABlAC4AcAB5ACcAOwAgAGUAeABpAHQAIAAkAEwAQQBTAFQARQBYAEkAVABDAE8ARABFAA==",
            "timeout": 15,
            "statusMessage": "Loading project state",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/absolute/path/to/repo/.codex/hooks/stop_project_state_check.py'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand JgAgACcAQwA6AFwAUABhAHQAaABcAHQAbwBcAHAAeQB0AGgAbwBuAC4AZQB4AGUAJwAgACcAQwA6AFwAcgBlAHAAbwBcAC4AYwBvAGQAZQB4AFwAaABvAG8AawBzAFwAcwB0AG8AcABfAHAAcgBvAGoAZQBjAHQAXwBzAHQAYQB0AGUAXwBjAGgAZQBjAGsALgBwAHkAJwA7ACAAZQB4AGkAdAAgACQATABBAFMAVABFAFgASQBUAEMATwBEAEUA",
            "timeout": 20,
            "statusMessage": "Checking project state"
          }
        ]
      }
    ]
  }
}
